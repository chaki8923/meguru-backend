# ファイル名: Dockerfile.dev

# Goのバージョンを1.24に更新
FROM golang:1.24-alpine

# Install git for fetching Go modules
RUN apk --no-cache add git

# airとmigrateのインストール
RUN go install github.com/air-verse/air@latest && \
    go install -tags 'postgres' github.com/golang-migrate/migrate/v4/cmd/migrate@latest

# 作業ディレクトリは /app (プロジェクトルート) に固定
WORKDIR /app

# go.modとgo.sumを先にコピーして依存関係をキャッシュ
# (go.modがルートにあるので、このパスで正しい)
COPY go.mod go.sum ./
RUN go mod download

# Install AWS SDK for Go v2
RUN go get github.com/aws/aws-sdk-go-v2/config github.com/aws/aws-sdk-go-v2/credentials github.com/aws/aws-sdk-go-v2/service/s3

# プロジェクトの全ファイルをコピー
COPY . .

# ポートを開放
EXPOSE 8080

# airを実行。WORKDIRが/appなので、.air.tomlを正しく読み込める
CMD ["air"]